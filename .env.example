// .env.example – environment variables required for the project

# PostgreSQL connection (Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth secret (generate a long random string)
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET"

# Authentication – credentials (email/password) – no external providers for admin
NEXTAUTH_URL="http://localhost:3000"

# Owner admin access (email + password + TOTP authenticator code)
ADMIN_EMAIL="owner@example.co.uk"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD"
ADMIN_TOTP_SECRET="BASE32_SECRET_FROM_YOUR_AUTHENTICATOR_SETUP"
ADMIN_SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# Stripe keys (test mode)
STRIPE_PUBLIC_KEY="pk_test_XXXXXXXXXXXXXXXX"
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXX"

# Cloudinary (or Uploadthing) – image storage
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Resend (or Postmark) email service
RESEND_API_KEY="re_XXXXXXXXXXXXXXXX"
ENQUIRY_TO_EMAIL="owner@example.co.uk"
RESEND_FROM_EMAIL="JDM Store <enquiries@your-verified-domain.co.uk>"

# Optional PayPal credentials (if used)
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_CLIENT_SECRET"

# Optional Klarna/Clearpay credentials – leave blank if not used
KLARNA_API_KEY=""
KLARNA_SECRET=""
